      <bpmndi:BPMNEdge id="p2_staff_and_users_f12_di" bpmnElement="p2_staff_and_users_f12"><di:waypoint x="2020" y="110" /><di:waypoint x="2075" y="110" /></bpmndi:BPMNEdge>
