      <bpmndi:BPMNEdge id="p2_staff_and_users_f6_di" bpmnElement="p2_staff_and_users_f6"><di:waypoint x="1295" y="415" /><di:waypoint x="1295" y="616" /><di:waypoint x="620" y="616" /><di:waypoint x="620" y="298" /><bpmndi:BPMNLabel><dc:Bounds x="1301" y="419" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
