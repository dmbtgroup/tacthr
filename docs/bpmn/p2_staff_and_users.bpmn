      <bpmndi:BPMNShape id="p2_staff_and_users_gM_di" bpmnElement="p2_staff_and_users_gM" isMarkerVisible="true"><dc:Bounds x="1485.0" y="85.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1440.0" y="39.0" width="140" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
