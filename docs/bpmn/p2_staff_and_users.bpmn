      <bpmndi:BPMNEdge id="p2_staff_and_users_f3_di" bpmnElement="p2_staff_and_users_f3"><di:waypoint x="730" y="250" /><di:waypoint x="785" y="250" /></bpmndi:BPMNEdge>
