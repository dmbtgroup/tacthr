      <bpmndi:BPMNEdge id="p2_staff_and_users_f1_di" bpmnElement="p2_staff_and_users_f1"><di:waypoint x="460" y="110" /><di:waypoint x="570" y="110" /><bpmndi:BPMNLabel><dc:Bounds x="466" y="92" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
