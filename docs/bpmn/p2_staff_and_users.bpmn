      <bpmndi:BPMNShape id="p2_staff_and_users_tUser_di" bpmnElement="p2_staff_and_users_tUser"><dc:Bounds x="1860.0" y="62.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_staff_and_users_tSend_di" bpmnElement="p2_staff_and_users_tSend"><dc:Bounds x="2075.0" y="62.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_staff_and_users_tSign_di" bpmnElement="p2_staff_and_users_tSign"><dc:Bounds x="2290.0" y="482.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_staff_and_users_e1_di" bpmnElement="p2_staff_and_users_e1"><dc:Bounds x="2567.0" y="512.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2527.0" y="552.0" width="116" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
