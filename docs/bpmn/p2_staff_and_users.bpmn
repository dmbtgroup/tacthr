<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p2_staff_and_users_defs" targetNamespace="https://tacthr.dmbtgroup.com/bpmn" exporter="tactHR docs" exporterVersion="1">
  <bpmn:collaboration id="p2_staff_and_users_collab">
    <bpmn:participant id="p2_staff_and_users_pool" name="2. Staff and user accounts" processRef="p2_staff_and_users" />
  </bpmn:collaboration>
  <bpmn:process id="p2_staff_and_users" name="2. Staff and user accounts" isExecutable="false">
    <bpmn:documentation>Managers and employees need a staff record linked to their account; people who leave are marked inactive, not deleted.</bpmn:documentation>
    <bpmn:laneSet id="p2_staff_and_users_lanes">
      <bpmn:lane id="p2_staff_and_users_lane_hr" name="HR / CEO">
        <bpmn:flowNodeRef>p2_staff_and_users_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tAdd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_staff_and_users_lane_sys" name="tactHR">
        <bpmn:flowNodeRef>p2_staff_and_users_sChk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gErr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_staff_and_users_lane_st" name="Staff member">
        <bpmn:flowNodeRef>p2_staff_and_users_tSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p2_staff_and_users_s" name="New staff or yearly update"><bpmn:outgoing>p2_staff_and_users_f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="p2_staff_and_users_g1" name="How?"><bpmn:incoming>p2_staff_and_users_f0</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f1</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_staff_and_users_tAdd" name="Add one person (staff form)"><bpmn:incoming>p2_staff_and_users_f1</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f8</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="p2_staff_and_users_tPrep" name="Prepare the Excel sheet in the 8 import columns"><bpmn:incoming>p2_staff_and_users_f2</bpmn:incoming><bpmn:incoming>p2_staff_and_users_f6</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p2_staff_and_users_tImp" name="Import from Excel"><bpmn:incoming>p2_staff_and_users_f3</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p2_staff_and_users_sChk" name="Check rows; add or update by personnel no.; create departments; link supervisors"><bpmn:incoming>p2_staff_and_users_f4</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gErr" name="Errors?"><bpmn:incoming>p2_staff_and_users_f5</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f6</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gM" name=""><bpmn:incoming>p2_staff_and_users_f7</bpmn:incoming><bpmn:incoming>p2_staff_and_users_f8</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gAcc" name="Needs a sign-in?"><bpmn:incoming>p2_staff_and_users_f9</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f10</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_staff_and_users_tUser" name="Create the user: name, email, role, staff record, password"><bpmn:incoming>p2_staff_and_users_f10</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f12</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="p2_staff_and_users_tSend" name="Send the sign-in address and password"><bpmn:incoming>p2_staff_and_users_f12</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f13</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p2_staff_and_users_tSign" name="Sign in and change the password"><bpmn:incoming>p2_staff_and_users_f13</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p2_staff_and_users_e1" name="Staff member can sign in"><bpmn:incoming>p2_staff_and_users_f14</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="p2_staff_and_users_e2" name="Staff recorded"><bpmn:incoming>p2_staff_and_users_f11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="p2_staff_and_users_f0" sourceRef="p2_staff_and_users_s" targetRef="p2_staff_and_users_g1" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f1" name="One person" sourceRef="p2_staff_and_users_g1" targetRef="p2_staff_and_users_tAdd" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f2" name="From Excel" sourceRef="p2_staff_and_users_g1" targetRef="p2_staff_and_users_tPrep" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f3" sourceRef="p2_staff_and_users_tPrep" targetRef="p2_staff_and_users_tImp" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f4" sourceRef="p2_staff_and_users_tImp" targetRef="p2_staff_and_users_sChk" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f5" sourceRef="p2_staff_and_users_sChk" targetRef="p2_staff_and_users_gErr" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f6" name="Yes: fix the rows" sourceRef="p2_staff_and_users_gErr" targetRef="p2_staff_and_users_tPrep" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f7" name="No" sourceRef="p2_staff_and_users_gErr" targetRef="p2_staff_and_users_gM" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f8" sourceRef="p2_staff_and_users_tAdd" targetRef="p2_staff_and_users_gM" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f9" sourceRef="p2_staff_and_users_gM" targetRef="p2_staff_and_users_gAcc" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f10" name="Yes" sourceRef="p2_staff_and_users_gAcc" targetRef="p2_staff_and_users_tUser" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f11" name="No" sourceRef="p2_staff_and_users_gAcc" targetRef="p2_staff_and_users_e2" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f12" sourceRef="p2_staff_and_users_tUser" targetRef="p2_staff_and_users_tSend" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f13" sourceRef="p2_staff_and_users_tSend" targetRef="p2_staff_and_users_tSign" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f14" sourceRef="p2_staff_and_users_tSign" targetRef="p2_staff_and_users_e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p2_staff_and_users_diagram">
    <bpmndi:BPMNPlane id="p2_staff_and_users_plane" bpmnElement="p2_staff_and_users_collab">
      <bpmndi:BPMNShape id="p2_staff_and_users_pool_di" bpmnElement="p2_staff_and_users_pool" isHorizontal="true"><dc:Bounds x="70" y="40" width="2650" height="560" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_staff_and_users_lane_hr_di" bpmnElement="p2_staff_and_users_lane_hr" isHorizontal="true"><dc:Bounds x="100" y="40" width="2620" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p2_staff_and_users_lane_sys_di" bpmnElement="p2_staff_and_users_lane_sys" isHorizontal="true"><dc:Bounds x="100" y="320" width="2620" height="140" /></bpmndi:BPMNShape>
