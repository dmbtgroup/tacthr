<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p4_half_year_evaluation_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="procedures" exporterVersion="1">
  <bpmn:collaboration id="p4_half_year_evaluation_collab">
    <bpmn:participant id="p4_half_year_evaluation_pool" name="4. Half-year performance evaluation" processRef="p4_half_year_evaluation" />
  </bpmn:collaboration>
  <bpmn:process id="p4_half_year_evaluation" name="4. Half-year performance evaluation" isExecutable="false">
    <bpmn:documentation>HR-WI-01 section 5 and spec v1.1. Nobody scores or approves their own evaluation.</bpmn:documentation>
    <bpmn:laneSet id="p4_half_year_evaluation_lanes">
      <bpmn:lane id="p4_half_year_evaluation_lane_hr" name="HR">
        <bpmn:flowNodeRef>p4_half_year_evaluation_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p4_half_year_evaluation_lane_sup" name="Supervisor">
        <bpmn:flowNodeRef>p4_half_year_evaluation_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p4_half_year_evaluation_lane_mgr" name="Unit manager">
        <bpmn:flowNodeRef>p4_half_year_evaluation_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p4_half_year_evaluation_lane_brd" name="CEO / board">
        <bpmn:flowNodeRef>p4_half_year_evaluation_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p4_half_year_evaluation_lane_sys" name="System">
        <bpmn:flowNodeRef>p4_half_year_evaluation_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_half_year_evaluation_s2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p4_half_year_evaluation_s" name="Half-year ends (31 Shahrivar / end of Esfand)"><bpmn:outgoing>p4_half_year_evaluation_f0</bpmn:outgoing><bpmn:timerEventDefinition id="p4_half_year_evaluation_s_timer" /></bpmn:startEvent>
    <bpmn:userTask id="p4_half_year_evaluation_t1" name="Open the half-year"><bpmn:incoming>p4_half_year_evaluation_f0</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f1</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p4_half_year_evaluation_s1" name="Copy the factors; add eligible staff (full-time, 3+ months); deadline = end + 20 days"><bpmn:incoming>p4_half_year_evaluation_f1</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="p4_half_year_evaluation_t2" name="Score each team member 1-5 per factor (and effectiveness)"><bpmn:incoming>p4_half_year_evaluation_f2</bpmn:incoming><bpmn:incoming>p4_half_year_evaluation_f4</bpmn:incoming><bpmn:incoming>p4_half_year_evaluation_f10</bpmn:incoming><bpmn:incoming>p4_half_year_evaluation_f13</bpmn:incoming><bpmn:incoming>p4_half_year_evaluation_f16</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="p4_half_year_evaluation_g1" name="Every score in?"><bpmn:incoming>p4_half_year_evaluation_f3</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f4</bpmn:outgoing><bpmn:outgoing>p4_half_year_evaluation_f5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p4_half_year_evaluation_t3" name="Send for approval"><bpmn:incoming>p4_half_year_evaluation_f5</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="p4_half_year_evaluation_g2" name="Unit manager above the supervisor?"><bpmn:incoming>p4_half_year_evaluation_f6</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f7</bpmn:outgoing><bpmn:outgoing>p4_half_year_evaluation_f8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p4_half_year_evaluation_t4" name="Review and approve"><bpmn:incoming>p4_half_year_evaluation_f7</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="p4_half_year_evaluation_g3" name="Approved?"><bpmn:incoming>p4_half_year_evaluation_f9</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f10</bpmn:outgoing><bpmn:outgoing>p4_half_year_evaluation_f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p4_half_year_evaluation_t5" name="Final approval (one by one or all waiting)"><bpmn:incoming>p4_half_year_evaluation_f8</bpmn:incoming><bpmn:incoming>p4_half_year_evaluation_f11</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="p4_half_year_evaluation_g4" name="Approved?"><bpmn:incoming>p4_half_year_evaluation_f12</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f13</bpmn:outgoing><bpmn:outgoing>p4_half_year_evaluation_f14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p4_half_year_evaluation_s2" name="Calculate the results; check for two half-years under 50 % (process 5)"><bpmn:incoming>p4_half_year_evaluation_f14</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p4_half_year_evaluation_g5" name="Everyone approved?"><bpmn:incoming>p4_half_year_evaluation_f15</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f16</bpmn:outgoing><bpmn:outgoing>p4_half_year_evaluation_f17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p4_half_year_evaluation_t6" name="Close the half-year"><bpmn:incoming>p4_half_year_evaluation_f17</bpmn:incoming><bpmn:outgoing>p4_half_year_evaluation_f18</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p4_half_year_evaluation_e" name="Results final"><bpmn:incoming>p4_half_year_evaluation_f18</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f0" sourceRef="p4_half_year_evaluation_s" targetRef="p4_half_year_evaluation_t1" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f1" sourceRef="p4_half_year_evaluation_t1" targetRef="p4_half_year_evaluation_s1" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f2" sourceRef="p4_half_year_evaluation_s1" targetRef="p4_half_year_evaluation_t2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f3" sourceRef="p4_half_year_evaluation_t2" targetRef="p4_half_year_evaluation_g1" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f4" name="No: keep scoring" sourceRef="p4_half_year_evaluation_g1" targetRef="p4_half_year_evaluation_t2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f5" name="Yes" sourceRef="p4_half_year_evaluation_g1" targetRef="p4_half_year_evaluation_t3" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f6" sourceRef="p4_half_year_evaluation_t3" targetRef="p4_half_year_evaluation_g2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f7" name="Yes" sourceRef="p4_half_year_evaluation_g2" targetRef="p4_half_year_evaluation_t4" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f8" name="No" sourceRef="p4_half_year_evaluation_g2" targetRef="p4_half_year_evaluation_t5" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f9" sourceRef="p4_half_year_evaluation_t4" targetRef="p4_half_year_evaluation_g3" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f10" name="No: send back" sourceRef="p4_half_year_evaluation_g3" targetRef="p4_half_year_evaluation_t2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f11" name="Yes" sourceRef="p4_half_year_evaluation_g3" targetRef="p4_half_year_evaluation_t5" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f12" sourceRef="p4_half_year_evaluation_t5" targetRef="p4_half_year_evaluation_g4" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f13" name="No: send back" sourceRef="p4_half_year_evaluation_g4" targetRef="p4_half_year_evaluation_t2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f14" name="Yes" sourceRef="p4_half_year_evaluation_g4" targetRef="p4_half_year_evaluation_s2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f15" sourceRef="p4_half_year_evaluation_s2" targetRef="p4_half_year_evaluation_g5" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f16" name="No: HR chases" sourceRef="p4_half_year_evaluation_g5" targetRef="p4_half_year_evaluation_t2" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f17" name="Yes" sourceRef="p4_half_year_evaluation_g5" targetRef="p4_half_year_evaluation_t6" />
    <bpmn:sequenceFlow id="p4_half_year_evaluation_f18" sourceRef="p4_half_year_evaluation_t6" targetRef="p4_half_year_evaluation_e" />
  </bpmn:process>
