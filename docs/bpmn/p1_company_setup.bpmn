<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p1_company_setup_defs" targetNamespace="https://tacthr.dmbtgroup.com/bpmn" exporter="tactHR docs" exporterVersion="1">
  <bpmn:collaboration id="p1_company_setup_collab">
    <bpmn:participant id="p1_company_setup_pool" name="1. Setting up a client company" processRef="p1_company_setup" />
  </bpmn:collaboration>
  <bpmn:process id="p1_company_setup" name="1. Setting up a client company" isExecutable="false">
    <bpmn:documentation>A platform admin creates each client company; its first user has the HR role.</bpmn:documentation>
    <bpmn:laneSet id="p1_company_setup_lanes">
      <bpmn:lane id="p1_company_setup_lane_pa" name="Platform admin (DMBT)">
        <bpmn:flowNodeRef>p1_company_setup_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_company_setup_lane_sys" name="tactHR">
        <bpmn:flowNodeRef>p1_company_setup_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_s2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_company_setup_lane_hr" name="Company HR">
        <bpmn:flowNodeRef>p1_company_setup_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_company_setup_s" name="New client company"><bpmn:outgoing>p1_company_setup_f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="p1_company_setup_t1" name="Create the company: name, address, evaluation method, languages, first HR user"><bpmn:incoming>p1_company_setup_f0</bpmn:incoming><bpmn:outgoing>p1_company_setup_f1</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p1_company_setup_s1" name="Create the company with the default factors and the HR sign-in"><bpmn:incoming>p1_company_setup_f1</bpmn:incoming><bpmn:outgoing>p1_company_setup_f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p1_company_setup_g1" name="Demo company?"><bpmn:incoming>p1_company_setup_f2</bpmn:incoming><bpmn:outgoing>p1_company_setup_f3</bpmn:outgoing><bpmn:outgoing>p1_company_setup_f4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p1_company_setup_s2" name="Fill with made-up staff, evaluations and salaries"><bpmn:incoming>p1_company_setup_f3</bpmn:incoming><bpmn:outgoing>p1_company_setup_f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="p1_company_setup_t2" name="Send HR the sign-in address and password"><bpmn:incoming>p1_company_setup_f4</bpmn:incoming><bpmn:incoming>p1_company_setup_f5</bpmn:incoming><bpmn:outgoing>p1_company_setup_f6</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p1_company_setup_t3" name="Sign in, change the password, check settings and languages"><bpmn:incoming>p1_company_setup_f6</bpmn:incoming><bpmn:outgoing>p1_company_setup_f7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p1_company_setup_e" name="Company ready"><bpmn:incoming>p1_company_setup_f7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="p1_company_setup_f0" sourceRef="p1_company_setup_s" targetRef="p1_company_setup_t1" />
    <bpmn:sequenceFlow id="p1_company_setup_f1" sourceRef="p1_company_setup_t1" targetRef="p1_company_setup_s1" />
    <bpmn:sequenceFlow id="p1_company_setup_f2" sourceRef="p1_company_setup_s1" targetRef="p1_company_setup_g1" />
    <bpmn:sequenceFlow id="p1_company_setup_f3" name="Yes" sourceRef="p1_company_setup_g1" targetRef="p1_company_setup_s2" />
    <bpmn:sequenceFlow id="p1_company_setup_f4" name="No" sourceRef="p1_company_setup_g1" targetRef="p1_company_setup_t2" />
    <bpmn:sequenceFlow id="p1_company_setup_f5" sourceRef="p1_company_setup_s2" targetRef="p1_company_setup_t2" />
    <bpmn:sequenceFlow id="p1_company_setup_f6" sourceRef="p1_company_setup_t2" targetRef="p1_company_setup_t3" />
    <bpmn:sequenceFlow id="p1_company_setup_f7" sourceRef="p1_company_setup_t3" targetRef="p1_company_setup_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p1_company_setup_diagram">
    <bpmndi:BPMNPlane id="p1_company_setup_plane" bpmnElement="p1_company_setup_collab">
      <bpmndi:BPMNShape id="p1_company_setup_pool_di" bpmnElement="p1_company_setup_pool" isHorizontal="true"><dc:Bounds x="70" y="40" width="1790" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_lane_pa_di" bpmnElement="p1_company_setup_lane_pa" isHorizontal="true"><dc:Bounds x="100" y="40" width="1760" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_lane_sys_di" bpmnElement="p1_company_setup_lane_sys" isHorizontal="true"><dc:Bounds x="100" y="180" width="1760" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_lane_hr_di" bpmnElement="p1_company_setup_lane_hr" isHorizontal="true"><dc:Bounds x="100" y="320" width="1760" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_s_di" bpmnElement="p1_company_setup_s"><dc:Bounds x="202.0" y="92.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="162.0" y="132.0" width="116" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_t1_di" bpmnElement="p1_company_setup_t1"><dc:Bounds x="355.0" y="62.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_s1_di" bpmnElement="p1_company_setup_s1"><dc:Bounds x="570.0" y="202.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_g1_di" bpmnElement="p1_company_setup_g1" isMarkerVisible="true"><dc:Bounds x="840.0" y="85.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="795.0" y="39.0" width="140" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_s2_di" bpmnElement="p1_company_setup_s2"><dc:Bounds x="1000.0" y="202.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_t2_di" bpmnElement="p1_company_setup_t2"><dc:Bounds x="1215.0" y="62.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_t3_di" bpmnElement="p1_company_setup_t3"><dc:Bounds x="1430.0" y="342.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_e_di" bpmnElement="p1_company_setup_e"><dc:Bounds x="1707.0" y="372.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1667.0" y="412.0" width="116" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p1_company_setup_f0_di" bpmnElement="p1_company_setup_f0"><di:waypoint x="238" y="110" /><di:waypoint x="355" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f1_di" bpmnElement="p1_company_setup_f1"><di:waypoint x="515" y="110" /><di:waypoint x="545" y="110" /><di:waypoint x="545" y="250" /><di:waypoint x="570" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f2_di" bpmnElement="p1_company_setup_f2"><di:waypoint x="730" y="250" /><di:waypoint x="815" y="250" /><di:waypoint x="815" y="110" /><di:waypoint x="840" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f3_di" bpmnElement="p1_company_setup_f3"><di:waypoint x="865" y="135" /><di:waypoint x="865" y="250" /><di:waypoint x="1000" y="250" /><bpmndi:BPMNLabel><dc:Bounds x="871" y="139" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f4_di" bpmnElement="p1_company_setup_f4"><di:waypoint x="890" y="110" /><di:waypoint x="1215" y="110" /><bpmndi:BPMNLabel><dc:Bounds x="896" y="92" width="110" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f5_di" bpmnElement="p1_company_setup_f5"><di:waypoint x="1160" y="250" /><di:waypoint x="1190" y="250" /><di:waypoint x="1190" y="110" /><di:waypoint x="1215" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f6_di" bpmnElement="p1_company_setup_f6"><di:waypoint x="1375" y="110" /><di:waypoint x="1405" y="110" /><di:waypoint x="1405" y="390" /><di:waypoint x="1430" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f7_di" bpmnElement="p1_company_setup_f7"><di:waypoint x="1590" y="390" /><di:waypoint x="1707" y="390" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
