<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p1_company_setup_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="procedures" exporterVersion="1">
  <bpmn:collaboration id="p1_company_setup_collab">
    <bpmn:participant id="p1_company_setup_pool" name="1. Setting up a client company" processRef="p1_company_setup" />
  </bpmn:collaboration>
  <bpmn:process id="p1_company_setup" name="1. Setting up a client company" isExecutable="false">
    <bpmn:documentation>The system administrator creates each client company; its first user has the HR role.</bpmn:documentation>
    <bpmn:laneSet id="p1_company_setup_lanes">
      <bpmn:lane id="p1_company_setup_lane_pa" name="System administrator">
        <bpmn:flowNodeRef>p1_company_setup_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_company_setup_lane_sys" name="System">
        <bpmn:flowNodeRef>p1_company_setup_s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p1_company_setup_lane_hr" name="Company HR">
        <bpmn:flowNodeRef>p1_company_setup_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_company_setup_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_company_setup_s" name="New client company"><bpmn:outgoing>p1_company_setup_f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="p1_company_setup_t1" name="Create the company: name, sign-in address, evaluation mode, languages, first HR user"><bpmn:incoming>p1_company_setup_f0</bpmn:incoming><bpmn:outgoing>p1_company_setup_f1</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p1_company_setup_s1" name="Create the company with the default factors and the HR sign-in"><bpmn:incoming>p1_company_setup_f1</bpmn:incoming><bpmn:outgoing>p1_company_setup_f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="p1_company_setup_t2" name="Send HR the sign-in address and password"><bpmn:incoming>p1_company_setup_f2</bpmn:incoming><bpmn:outgoing>p1_company_setup_f3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p1_company_setup_t3" name="Sign in, change the password, check settings and languages"><bpmn:incoming>p1_company_setup_f3</bpmn:incoming><bpmn:outgoing>p1_company_setup_f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p1_company_setup_e" name="Company ready"><bpmn:incoming>p1_company_setup_f4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="p1_company_setup_f0" sourceRef="p1_company_setup_s" targetRef="p1_company_setup_t1" />
    <bpmn:sequenceFlow id="p1_company_setup_f1" sourceRef="p1_company_setup_t1" targetRef="p1_company_setup_s1" />
    <bpmn:sequenceFlow id="p1_company_setup_f2" sourceRef="p1_company_setup_s1" targetRef="p1_company_setup_t2" />
    <bpmn:sequenceFlow id="p1_company_setup_f3" sourceRef="p1_company_setup_t2" targetRef="p1_company_setup_t3" />
    <bpmn:sequenceFlow id="p1_company_setup_f4" sourceRef="p1_company_setup_t3" targetRef="p1_company_setup_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p1_company_setup_diagram">
    <bpmndi:BPMNPlane id="p1_company_setup_plane" bpmnElement="p1_company_setup_collab">
      <bpmndi:BPMNShape id="p1_company_setup_pool_di" bpmnElement="p1_company_setup_pool" isHorizontal="true"><dc:Bounds x="70" y="40" width="1360" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_lane_pa_di" bpmnElement="p1_company_setup_lane_pa" isHorizontal="true"><dc:Bounds x="100" y="40" width="1330" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_lane_sys_di" bpmnElement="p1_company_setup_lane_sys" isHorizontal="true"><dc:Bounds x="100" y="180" width="1330" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_lane_hr_di" bpmnElement="p1_company_setup_lane_hr" isHorizontal="true"><dc:Bounds x="100" y="320" width="1330" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_s_di" bpmnElement="p1_company_setup_s"><dc:Bounds x="202.0" y="92.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="162.0" y="132.0" width="116" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_t1_di" bpmnElement="p1_company_setup_t1"><dc:Bounds x="355.0" y="62.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_s1_di" bpmnElement="p1_company_setup_s1"><dc:Bounds x="570.0" y="202.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_t2_di" bpmnElement="p1_company_setup_t2"><dc:Bounds x="785.0" y="62.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_t3_di" bpmnElement="p1_company_setup_t3"><dc:Bounds x="1000.0" y="342.0" width="160" height="96" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p1_company_setup_e_di" bpmnElement="p1_company_setup_e"><dc:Bounds x="1277.0" y="372.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1237.0" y="412.0" width="116" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p1_company_setup_f0_di" bpmnElement="p1_company_setup_f0"><di:waypoint x="238" y="110" /><di:waypoint x="355" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f1_di" bpmnElement="p1_company_setup_f1"><di:waypoint x="515" y="110" /><di:waypoint x="545" y="110" /><di:waypoint x="545" y="250" /><di:waypoint x="570" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f2_di" bpmnElement="p1_company_setup_f2"><di:waypoint x="730" y="250" /><di:waypoint x="760" y="250" /><di:waypoint x="760" y="110" /><di:waypoint x="785" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f3_di" bpmnElement="p1_company_setup_f3"><di:waypoint x="945" y="110" /><di:waypoint x="975" y="110" /><di:waypoint x="975" y="390" /><di:waypoint x="1000" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p1_company_setup_f4_di" bpmnElement="p1_company_setup_f4"><di:waypoint x="1160" y="390" /><di:waypoint x="1277" y="390" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
