  <bpmn:collaboration id="p5_poor_performance_collab">
    <bpmn:participant id="p5_poor_performance_pool" name="۵. پیگیری عملکرد نامناسب" processRef="p5_poor_performance" />
  </bpmn:collaboration>
  <bpmn:process id="p5_poor_performance" name="۵. پیگیری عملکرد نامناسب" isExecutable="false">
    <bpmn:documentation>HR-WI-01 5-3 and spec v1.1 section 5. Under 50 % also means no bonus that year.</bpmn:documentation>
    <bpmn:laneSet id="p5_poor_performance_lanes">
      <bpmn:lane id="p5_poor_performance_lane_sys" name="سامانه">
        <bpmn:flowNodeRef>p5_poor_performance_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p5_poor_performance_lane_hr" name="منابع انسانی با سرپرست، مدیر واحد و مدیرعامل">
        <bpmn:flowNodeRef>p5_poor_performance_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5_poor_performance_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p5_poor_performance_s" name="تأیید یک نمره توسط هیئت‌مدیره"><bpmn:outgoing>p5_poor_performance_f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="p5_poor_performance_g1" name="زیر ۵۰٪؟"><bpmn:incoming>p5_poor_performance_f0</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f1</bpmn:outgoing><bpmn:outgoing>p5_poor_performance_f2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p5_poor_performance_s1" name="ثبت عملکرد نامناسب"><bpmn:incoming>p5_poor_performance_f1</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p5_poor_performance_g2" name="نیم‌سال قبل هم زیر ۵۰٪؟"><bpmn:incoming>p5_poor_performance_f3</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f4</bpmn:outgoing><bpmn:outgoing>p5_poor_performance_f5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="p5_poor_performance_s2" name="هشدار به منابع انسانی"><bpmn:incoming>p5_poor_performance_f4</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="p5_poor_performance_t1" name="جلسه درباره ادامه همکاری"><bpmn:incoming>p5_poor_performance_f6</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f7</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="p5_poor_performance_g3" name="تصمیم"><bpmn:incoming>p5_poor_performance_f7</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f8</bpmn:outgoing><bpmn:outgoing>p5_poor_performance_f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="p5_poor_performance_t2" name="ثبت تصمیم و برنامه بهبود"><bpmn:incoming>p5_poor_performance_f8</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p5_poor_performance_t3" name="پایان همکاری: برداشتن تیک فعال (سوابق حفظ می‌شود)"><bpmn:incoming>p5_poor_performance_f9</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="p5_poor_performance_t4" name="ثبت انجام هشدار"><bpmn:incoming>p5_poor_performance_f10</bpmn:incoming><bpmn:incoming>p5_poor_performance_f11</bpmn:incoming><bpmn:outgoing>p5_poor_performance_f12</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p5_poor_performance_e1" name="پیگیری شد"><bpmn:incoming>p5_poor_performance_f12</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="p5_poor_performance_e2" name="اقدامی لازم نیست"><bpmn:incoming>p5_poor_performance_f2</bpmn:incoming><bpmn:incoming>p5_poor_performance_f5</bpmn:incoming></bpmn:endEvent>
