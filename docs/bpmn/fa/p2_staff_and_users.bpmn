<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p2_staff_and_users_defs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="procedures" exporterVersion="1">
  <bpmn:collaboration id="p2_staff_and_users_collab">
    <bpmn:participant id="p2_staff_and_users_pool" name="۲. پرسنل و حساب‌های کاربری" processRef="p2_staff_and_users" />
  </bpmn:collaboration>
  <bpmn:process id="p2_staff_and_users" name="۲. پرسنل و حساب‌های کاربری" isExecutable="false">
    <bpmn:documentation>Each person has up to three scorers: the supervisor (always) and up to two more. Managers and employees need a staff record linked to their account; people who leave are marked inactive, not deleted.</bpmn:documentation>
    <bpmn:laneSet id="p2_staff_and_users_lanes">
      <bpmn:lane id="p2_staff_and_users_lane_hr" name="منابع انسانی / مدیرعامل">
        <bpmn:flowNodeRef>p2_staff_and_users_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tAdd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tImp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tSc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gSm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_tSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_staff_and_users_lane_sys" name="سامانه">
        <bpmn:flowNodeRef>p2_staff_and_users_sChk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_gErr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_sAll</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p2_staff_and_users_lane_st" name="کارمند">
        <bpmn:flowNodeRef>p2_staff_and_users_tSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_staff_and_users_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p2_staff_and_users_s" name="پرسنل جدید یا به‌روزرسانی سالانه"><bpmn:outgoing>p2_staff_and_users_f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="p2_staff_and_users_g1" name="چگونه؟"><bpmn:incoming>p2_staff_and_users_f0</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f1</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_staff_and_users_tAdd" name="افزودن یک نفر (فرم پرسنل)"><bpmn:incoming>p2_staff_and_users_f1</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f8</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="p2_staff_and_users_tPrep" name="آماده‌سازی فایل اکسل با ۸ ستون ورود"><bpmn:incoming>p2_staff_and_users_f2</bpmn:incoming><bpmn:incoming>p2_staff_and_users_f6</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p2_staff_and_users_tImp" name="ورود از اکسل"><bpmn:incoming>p2_staff_and_users_f3</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p2_staff_and_users_sChk" name="بررسی ردیف‌ها؛ افزودن یا به‌روزرسانی با شماره پرسنلی؛ ایجاد واحدها؛ اتصال سرپرستان"><bpmn:incoming>p2_staff_and_users_f4</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gErr" name="خطا؟"><bpmn:incoming>p2_staff_and_users_f5</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f6</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gM" name=""><bpmn:incoming>p2_staff_and_users_f7</bpmn:incoming><bpmn:incoming>p2_staff_and_users_f8</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gS" name="امتیازدهنده: یک نفر یا همه؟"><bpmn:incoming>p2_staff_and_users_f9</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f10</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_staff_and_users_tSc" name="در پروفایل فرد، انتخاب حداکثر ۳ امتیازدهنده: سرپرست و حداکثر ۲ نفر دیگر"><bpmn:incoming>p2_staff_and_users_f10</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="p2_staff_and_users_tAll" name="امتیازدهنده دوم یا سوم برای همه: انتخاب فرد، همه یا یک واحد، جایگزینی موارد فعلی یا نه"><bpmn:incoming>p2_staff_and_users_f11</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p2_staff_and_users_sAll" name="تعیین آن امتیازدهنده برای همه افراد دامنه به جز خودش؛ بدون جایگزینی فقط جاهای خالی"><bpmn:incoming>p2_staff_and_users_f12</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gSm" name=""><bpmn:incoming>p2_staff_and_users_f13</bpmn:incoming><bpmn:incoming>p2_staff_and_users_f14</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_staff_and_users_gAcc" name="حساب کاربری لازم است؟"><bpmn:incoming>p2_staff_and_users_f15</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f16</bpmn:outgoing><bpmn:outgoing>p2_staff_and_users_f17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p2_staff_and_users_tUser" name="ایجاد کاربر: نام، ایمیل، نقش، پرونده پرسنلی، رمز عبور"><bpmn:incoming>p2_staff_and_users_f16</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f18</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="p2_staff_and_users_tSend" name="ارسال نشانی ورود و رمز عبور"><bpmn:incoming>p2_staff_and_users_f18</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f19</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="p2_staff_and_users_tSign" name="ورود و تغییر رمز عبور"><bpmn:incoming>p2_staff_and_users_f19</bpmn:incoming><bpmn:outgoing>p2_staff_and_users_f20</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p2_staff_and_users_e1" name="کارمند می‌تواند وارد شود"><bpmn:incoming>p2_staff_and_users_f20</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="p2_staff_and_users_e2" name="پرسنل ثبت شد"><bpmn:incoming>p2_staff_and_users_f17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="p2_staff_and_users_f0" sourceRef="p2_staff_and_users_s" targetRef="p2_staff_and_users_g1" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f1" name="یک نفر" sourceRef="p2_staff_and_users_g1" targetRef="p2_staff_and_users_tAdd" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f2" name="از اکسل" sourceRef="p2_staff_and_users_g1" targetRef="p2_staff_and_users_tPrep" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f3" sourceRef="p2_staff_and_users_tPrep" targetRef="p2_staff_and_users_tImp" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f4" sourceRef="p2_staff_and_users_tImp" targetRef="p2_staff_and_users_sChk" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f5" sourceRef="p2_staff_and_users_sChk" targetRef="p2_staff_and_users_gErr" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f6" name="بله: اصلاح ردیف‌ها" sourceRef="p2_staff_and_users_gErr" targetRef="p2_staff_and_users_tPrep" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f7" name="خیر" sourceRef="p2_staff_and_users_gErr" targetRef="p2_staff_and_users_gM" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f8" sourceRef="p2_staff_and_users_tAdd" targetRef="p2_staff_and_users_gM" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f9" sourceRef="p2_staff_and_users_gM" targetRef="p2_staff_and_users_gS" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f10" name="یک نفر" sourceRef="p2_staff_and_users_gS" targetRef="p2_staff_and_users_tSc" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f11" name="همه" sourceRef="p2_staff_and_users_gS" targetRef="p2_staff_and_users_tAll" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f12" sourceRef="p2_staff_and_users_tAll" targetRef="p2_staff_and_users_sAll" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f13" sourceRef="p2_staff_and_users_tSc" targetRef="p2_staff_and_users_gSm" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f14" sourceRef="p2_staff_and_users_sAll" targetRef="p2_staff_and_users_gSm" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f15" sourceRef="p2_staff_and_users_gSm" targetRef="p2_staff_and_users_gAcc" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f16" name="بله" sourceRef="p2_staff_and_users_gAcc" targetRef="p2_staff_and_users_tUser" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f17" name="خیر" sourceRef="p2_staff_and_users_gAcc" targetRef="p2_staff_and_users_e2" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f18" sourceRef="p2_staff_and_users_tUser" targetRef="p2_staff_and_users_tSend" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f19" sourceRef="p2_staff_and_users_tSend" targetRef="p2_staff_and_users_tSign" />
    <bpmn:sequenceFlow id="p2_staff_and_users_f20" sourceRef="p2_staff_and_users_tSign" targetRef="p2_staff_and_users_e1" />
  </bpmn:process>
