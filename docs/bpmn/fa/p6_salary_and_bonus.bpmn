<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="p6_salary_and_bonus_defs" targetNamespace="https://tacthr.dmbtgroup.com/bpmn" exporter="tactHR docs" exporterVersion="1">
  <bpmn:collaboration id="p6_salary_and_bonus_collab">
    <bpmn:participant id="p6_salary_and_bonus_pool" name="۶. حقوق و پاداش سالانه" processRef="p6_salary_and_bonus" />
  </bpmn:collaboration>
  <bpmn:process id="p6_salary_and_bonus" name="۶. حقوق و پاداش سالانه" isExecutable="false">
    <bpmn:documentation>Salary instruction: salary = minimum wage + A x (education + experience + skill + difficulty + grade + performance + CEO score).</bpmn:documentation>
    <bpmn:laneSet id="p6_salary_and_bonus_lanes">
      <bpmn:lane id="p6_salary_and_bonus_lane_brd" name="مدیرعامل / هیئت‌مدیره">
        <bpmn:flowNodeRef>p6_salary_and_bonus_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p6_salary_and_bonus_lane_hr" name="منابع انسانی">
        <bpmn:flowNodeRef>p6_salary_and_bonus_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="p6_salary_and_bonus_lane_sys" name="tactHR">
        <bpmn:flowNodeRef>p6_salary_and_bonus_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6_salary_and_bonus_s2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p6_salary_and_bonus_s" name="سال جدید (مهلت حقوق‌ها ۳۱ فروردین)"><bpmn:outgoing>p6_salary_and_bonus_f0</bpmn:outgoing><bpmn:timerEventDefinition id="p6_salary_and_bonus_s_timer" /></bpmn:startEvent>
    <bpmn:userTask id="p6_salary_and_bonus_t1" name="تعیین حداقل دستمزد، سقف حقوق و مبنای پاداش (A = سقف − حداقل)"><bpmn:incoming>p6_salary_and_bonus_f0</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f1</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="p6_salary_and_bonus_t2" name="باز کردن سال حقوقی"><bpmn:incoming>p6_salary_and_bonus_f1</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p6_salary_and_bonus_s1" name="کپی شاخص‌های سال قبل با یک سال سابقه بیشتر"><bpmn:incoming>p6_salary_and_bonus_f2</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="p6_salary_and_bonus_t3" name="برای هر نفر: تحصیلات، سابقه، مهارت، سختی کار، رتبه و حساسیت"><bpmn:incoming>p6_salary_and_bonus_f3</bpmn:incoming><bpmn:incoming>p6_salary_and_bonus_f11</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="p6_salary_and_bonus_s2" name="افزودن میانگین عملکرد سال قبل؛ محاسبه حقوق و پاداش؛ هشدار بیش از سقف"><bpmn:incoming>p6_salary_and_bonus_f4</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="p6_salary_and_bonus_g1" name="دوره آزمایشی؟"><bpmn:incoming>p6_salary_and_bonus_f5</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f6</bpmn:outgoing><bpmn:outgoing>p6_salary_and_bonus_f7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p6_salary_and_bonus_t4" name="امتیاز مدیرعامل (۰ تا ۲۰٪)"><bpmn:incoming>p6_salary_and_bonus_f6</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="p6_salary_and_bonus_t5" name="تعیین حقوق دوره آزمایشی (نه کمتر از حداقل دستمزد)"><bpmn:incoming>p6_salary_and_bonus_f7</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="p6_salary_and_bonus_gm" name=""><bpmn:incoming>p6_salary_and_bonus_f8</bpmn:incoming><bpmn:incoming>p6_salary_and_bonus_f9</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p6_salary_and_bonus_g2" name="حقوق درست است؟"><bpmn:incoming>p6_salary_and_bonus_f10</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f11</bpmn:outgoing><bpmn:outgoing>p6_salary_and_bonus_f12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="p6_salary_and_bonus_t6" name="تأیید (تک‌به‌تک یا همه موارد کامل)"><bpmn:incoming>p6_salary_and_bonus_f12</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="p6_salary_and_bonus_t7" name="بستن سال حقوقی"><bpmn:incoming>p6_salary_and_bonus_f13</bpmn:incoming><bpmn:outgoing>p6_salary_and_bonus_f14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="p6_salary_and_bonus_e" name="پرداخت حقوق و پاداش"><bpmn:incoming>p6_salary_and_bonus_f14</bpmn:incoming></bpmn:endEvent>
