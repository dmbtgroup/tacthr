    <bpmn:sequenceFlow id="p6_salary_and_bonus_f8" sourceRef="p6_salary_and_bonus_t4" targetRef="p6_salary_and_bonus_gm" />
    <bpmn:sequenceFlow id="p6_salary_and_bonus_f9" sourceRef="p6_salary_and_bonus_t5" targetRef="p6_salary_and_bonus_gm" />
